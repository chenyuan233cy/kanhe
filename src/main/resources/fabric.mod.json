{
  "schemaVersion": 1,
  "id": "kanhe",
  "version": "${version}",
  "name": "Kanhe",
  "description": "Asks for a masked join password before connecting to a server; the password is verified server-side, and the admin can rotate it or change its format (digits / letters / mixed) and length at any time.",
  "authors": [
    "尘渊233"
  ],
  "contact": {
    "homepage": "https://github.com/chenyuan233cy/kanhe",
    "sources": "https://github.com/chenyuan233cy/kanhe",
    "issues": "https://github.com/chenyuan233cy/kanhe/issues"
  },
  "license": "MIT",
  "environment": "*",
  "entrypoints": {
    "main": [
      "com.kanhe.KanheMod"
    ],
    "client": [
      "com.kanhe.client.KanheClient"
    ]
  },
  "mixins": [
    "kanhe.mixins.json",
    {
      "config": "kanhe.client.mixins.json",
      "environment": "client"
    }
  ],
  "depends": {
    "fabricloader": ">=0.19.5",
    "java": ">=25"
  }
}
